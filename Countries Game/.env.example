# Copy this file to .env and fill in your key. Without a key the site still
# works, serving its built-in rounds only.
GEMINI_API_KEY=

# Optional: override the model (default: gemini-3.8-flash, falls back to gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: port to listen on (default 3000)
# PORT=3000

# Optional: generated rounds allowed per visitor IP per 15 minutes (default 40).
# Past the limit, visitors get built-in rounds instead.
# ROUND_RATE_LIMIT=40

# Set to 1 when running behind a reverse proxy / host that sets X-Forwarded-For
# (Render, Railway, Fly, Heroku...), so rate limiting sees real visitor IPs.
# TRUST_PROXY=1

# Comma-separated sites allowed to request rounds from this server, e.g. the
# GitHub Pages copy of the game.
# ALLOWED_ORIGINS=https://armoredpawn.github.io
