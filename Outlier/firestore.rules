rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then Publish.
// Browsers may open today's or an earlier daily puzzle, any Unlimited prompt and the Unlimited list.
// Nothing else can be read, and nothing can be written: the seed script and the server use an admin key,
// which these rules don't apply to.
service cloud.firestore {
  match /databases/{database}/documents {
    match /daily/{day} {
      allow get: if request.time >= resource.data.opensAt;
    }
    match /unlimited/{promptId} {
      allow get: if true;
    }
    match /meta/public {
      allow get: if true;
    }
  }
}
