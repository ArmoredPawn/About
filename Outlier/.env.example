# Copy this file to .env for local settings. Without any Firebase settings, `npm run dev` plays from dev-data/
# (made by `npm run seed:local`) and serves the game at http://localhost:3000.

# The Firebase admin key, pasted whole (on Render this goes in the Environment tab instead).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}

# Or a path to the key file. `npm run seed` also looks for service-account.json in this folder by itself.
# FIREBASE_SERVICE_ACCOUNT_FILE=service-account.json

# Sites allowed to open a room connection (comma-separated). Empty allows any.
# ALLOWED_ORIGINS=https://armoredpawn.github.io

# Optional: port to listen on (default 3000)
# PORT=3000
